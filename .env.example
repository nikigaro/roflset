# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable ключ (или legacy anon — достаточно одного)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ТОЛЬКО НА СЕРВЕРЕ. Никогда не добавляйте NEXT_PUBLIC_ префикс.
# Используется для recovery_codes, chat_mutes, rate_limits и auth.admin.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Опционально: точный origin продакшена для проверки CSRF Origin (например https://example.vercel.app)
APP_ORIGIN=

# URL Edge Function модерации (после `supabase functions deploy moderate-message`)
MODERATION_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/moderate-message

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile)
# Тестовые ключи для локальной разработки (всегда проходят проверку):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
